<Project>
  <!--
    Impl-only until an abstract package exists:
      Version = Major.0.ImpMajor.ImpMinor
    Major is pinned to Zaya.Primitives' major (Zaya.UI depends on Zaya.Primitives),
    matching the same rule used by Zaya.OCR/Screenshot/Translator.
    The second digit is reserved for a future ZayaVersionInterface.
  -->
  <PropertyGroup Condition="'$(ZayaVersionRole)' == 'impl'">
    <Version>$(ZayaPrimitivesMajor).0.$(ZayaVersionImpMajor).$(ZayaVersionImpMinor)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZayaVersionRole)' != 'impl'">
    <Version>$(ZayaPrimitivesMajor).0.0</Version>
  </PropertyGroup>

  <Target Name="ValidateZayaVersion" BeforeTargets="BeforeBuild;GenerateNuspec">
    <Error
      Condition="'$(ZayaPrimitivesVersion)' == ''"
      Text="ZayaPrimitivesVersion must be set in Directory.Build.props." />
    <Error
      Condition="'$(ZayaVersionRole)' == 'impl' AND ('$(ZayaVersionImpMajor)' == '' OR '$(ZayaVersionImpMinor)' == '')"
      Text="Impl project must set ZayaVersionImpMajor and ZayaVersionImpMinor." />
    <Error
      Condition="$([System.Version]::Parse('$(Version)').Major) != $([System.Version]::Parse('$(ZayaPrimitivesVersion)').Major)"
      Text="Version $(Version) major must equal Zaya.Primitives major $([System.Version]::Parse('$(ZayaPrimitivesVersion)').Major) (ZayaPrimitivesVersion=$(ZayaPrimitivesVersion))." />
  </Target>
</Project>
